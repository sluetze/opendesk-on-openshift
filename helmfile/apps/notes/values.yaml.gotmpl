---
global:
  collaborationServerSecret:
    existingSecret:
      name: {{ .Values.secrets.notes.collaborationSecret.name | quote }}
      key: {{ .Values.secrets.notes.collaborationSecret.key | quote }}
  fqdn: "{{ .Values.global.hosts.notes }}.{{ .Values.global.domain }}"
  imagePullSecrets:
    {{ .Values.global.imagePullSecrets | toYaml | nindent 4 }}
  tlsSecretName: {{ .Values.ingress.tls.secretName | quote }}
  yProviderApiKey:
    existingSecret:
      name: {{ .Values.secrets.notes.collaborationSecret.name | quote }}
      key: {{ .Values.secrets.notes.collaborationSecret.key | quote }}
  s3:
    {{- if .Values.objectstores.notes.endpoint }}
    host: {{ printf "%s" .Values.objectstores.notes.endpoint | quote }}
    {{- else if .Values.apps.minio.enabled }}
    host: {{ printf "%s.%s" .Values.global.hosts.minioApi .Values.global.domain | quote }}
    {{- else if .Values.apps.seaweedfs.enabled }}
    host: {{ printf "%s.%s" .Values.global.hosts.seaweedfs .Values.global.domain | quote }}
    {{- else }}
    {{- fail "No objectstorage endpoint for notes found!" }}
    {{- end }}
    port: {{ .Values.objectstores.notes.port }}
    bucketName: {{ .Values.objectstores.notes.bucket | quote }}
    accessKeyId:
      value: {{ .Values.objectstores.notes.username | quote }}
    secretAccessKey:
      value: {{ .Values.objectstores.notes.secretKey.value | quote }}

backend:
  image:
    registry: {{ coalesce .Values.repositories.image.registryOpencodeDe .Values.global.imageRegistry .Values.images.notesBackend.registry | quote }}
    repository: {{ .Values.images.notesBackend.repository | quote }}
    pullPolicy: {{ .Values.global.imagePullPolicy | quote }}
    tag: {{ .Values.images.notesBackend.tag | quote }}
  ingress:
    annotations:
      nginx.ingress.kubernetes.io/proxy-body-size: {{ .Values.ingress.parameters.bodySize.notes | quote }}
      nginx.ingress.kubernetes.io/proxy-read-timeout: {{ .Values.ingress.parameters.bodyTimeout.notes | quote }}
      nginx.ingress.kubernetes.io/proxy-send-timeout: {{ .Values.ingress.parameters.bodyTimeout.notes | quote }}
      haproxy-ingress.github.io/proxy-body-size: {{ .Values.ingress.parameters.bodySize.notes | quote }}
      haproxy-ingress.github.io/timeout-server: "{{ .Values.ingress.parameters.bodyTimeout.notes}}s"
      {{- if .Values.annotations.notesBackend.ingress }}
      {{ .Values.annotations.notesBackend.ingress | toYaml | nindent 6 }}
      {{- end }}
    ingressClassName: {{ .Values.ingress.ingressClassName }}
  ingressAdmin:
    enabled: false
    annotations:
      {{ .Values.annotations.notesBackend.ingressAdmin | toYaml | nindent 6 }}
    ingressClassName: {{ .Values.ingress.ingressClassName }}
  replicaCount: {{ .Values.replicas.notesBackend }}
  configuration:
    ai:
      enabled: {{ if not (quote .Values.ai.endpoint | empty) }}true{{- else }}false{{- end }}
      apiKey:
        value: {{ .Values.ai.apiKey.value }}
      baseUrl: {{ .Values.ai.endpoint }}
      model: {{ .Values.ai.model | quote }}
      allowReachFrom: "authenticated"
    collaboration:
      apiUrl: {{ printf "https://%s.%s/collaboration/api/" .Values.global.hosts.notes .Values.global.domain | quote }}
      wsUrl: {{ printf "wss://%s.%s/collaboration/ws/" .Values.global.hosts.notes .Values.global.domain | quote }}
    docSpec:
      # Docs 5.0 split the DOCX -> Yjs import path: the backend hands the
      # DOCX -> BlockNote leg to docSpec before y-provider takes over. Disabling
      # this only costs DOCX import; export and everything else keep working.
      enabled: true
      apiUrl: {{ printf "http://%s.%s.svc.%s" "impress-docspec" (.Values.apps.notes.namespace | default .Release.Namespace) .Values.cluster.networking.domain | quote }}
    database:
      host: {{ .Values.databases.notes.host | quote }}
      name: {{ .Values.databases.notes.name | quote }}
      password:
        value: {{ .Values.databases.notes.password.value | quote }}
      port: {{ .Values.databases.notes.port | quote }}
      user:
        value: {{ .Values.databases.notes.username | quote }}
    email:
      brandName: "openDesk"
      from: "{{ .Values.smtp.localpartNoReply }}@{{ .Values.global.mailDomain | default .Values.global.domain }}"
      host: "postfix"
      port: "25"
      logoImage: {{ printf "https://%s.%s/univention/portal/icons/entries/swp.notes.svg" .Values.global.hosts.nubus .Values.global.domain | quote }}
      user:
        value: {{ printf "%s@%s" "opendesk-system" ( .Values.global.mailDomain | default .Values.global.domain ) }}
      password:
        existingSecret:
          name: {{ .Values.secrets.postfix.opendeskSystemPassword.name | quote }}
          key: {{ .Values.secrets.postfix.opendeskSystemPassword.key | quote }}
    oidc:
      enabled: true
      rpClientId:
        value: "opendesk-notes"
      rpClientSecret:
        # Consume the OIDC client secret from the managed Secret (existingSecret). The
        # keycloak-bootstrap registration points at the same Secret/key (secrets.yaml.gotmpl).
        existingSecret:
          name: {{ .Values.secrets.keycloak.clientSecret.notes.name | quote }}
          key: {{ .Values.secrets.keycloak.clientSecret.notes.key | quote }}
      opJWKSEndpoint: "https://{{ .Values.global.hosts.keycloak }}.{{ .Values.global.domain }}/realms/{{ .Values.platform.realm }}/protocol/openid-connect/certs"
      opAuthorizationEndpoint: "https://{{ .Values.global.hosts.keycloak }}.{{ .Values.global.domain }}/realms/{{ .Values.platform.realm }}/protocol/openid-connect/auth"
      opTokenEndpoint: "https://{{ .Values.global.hosts.keycloak }}.{{ .Values.global.domain }}/realms/{{ .Values.platform.realm }}/protocol/openid-connect/token"
      opUserEndpoint: "https://{{ .Values.global.hosts.keycloak }}.{{ .Values.global.domain }}/realms/{{ .Values.platform.realm }}/protocol/openid-connect/userinfo"
      opLogoutEndpoint: "https://{{ .Values.global.hosts.keycloak }}.{{ .Values.global.domain }}/realms/{{ .Values.platform.realm }}/protocol/openid-connect/logout"
      rpScopes: "openid opendesk-notes-scope"
      loginRedirectUrl: {{ printf "https://%s.%s" .Values.global.hosts.notes .Values.global.domain | quote }}
      loginRedirectUrlFailure: {{ printf "https://%s.%s" .Values.global.hosts.nubus .Values.global.domain | quote }}
      logoutRedirectUrl: {{ printf "https://%s.%s" .Values.global.hosts.nubus .Values.global.domain | quote }}
      redirectAllowedHosts: {{ printf "https://%s.%s/*" .Values.global.hosts.notes .Values.global.domain | quote }}
      essentialClaims: "email"
      fullnameFields: "given_name,family_name"
      shortnameField: "given_name"
    django:
      secretKey:
        existingSecret:
          name: {{ .Values.secrets.notes.djangoSecretKey.name | quote }}
          key: {{ .Values.secrets.notes.djangoSecretKey.key | quote }}
      createSuperuser: true
      superuserEmail:
        value: {{ printf "default.admin@%s" .Values.global.domain | quote }}
      superuserPassword:
        existingSecret:
          name: {{ .Values.secrets.notes.superuser.name | quote }}
          key: {{ .Values.secrets.notes.superuser.key | quote }}
    frontendTheme: "openDesk"
    redisUrl:
      value: {{ printf "%s://%s:%s@%s:%v/7"
        (ternary "rediss" "redis" .Values.cache.notes.tls)
        (.Values.cache.notes.username | urlquery | replace "+" "%20")
        (.Values.cache.notes.password.value | urlquery | replace "+" "%20")
        .Values.cache.notes.host
        .Values.cache.notes.port | quote }}
    celery:
      broker:
        scheme: {{ ternary "rediss" "redis" .Values.cache.notes.tls | quote }}
        host: {{ .Values.cache.notes.host | quote }}
        port: {{ .Values.cache.notes.port }}
        database: "8"
        username: {{ .Values.cache.notes.username | quote }}
        password:
          # Percent-encoded here, since the chart joins it into the broker URL as it is.
          value: {{ .Values.cache.notes.password.value | urlquery | replace "+" "%20" | quote }}
  extraEnvVars:
    - name: "FRONTEND_HOMEPAGE_FEATURE_ENABLED"
      value: "False"
    - name: "FRONTEND_FOOTER_FEATURE_ENABLED"
      value: "False"
  {{- with .Values.technical.notes.rateLimit }}
    {{- with .document }}
    - name: "API_DOCUMENT_THROTTLE_RATE"
      value: {{ . | quote }}
    {{- end }}
    {{- with .documentAccess }}
    - name: "API_DOCUMENT_ACCESS_THROTTLE_RATE"
      value: {{ . | quote }}
    {{- end }}
    {{- with .invitation }}
    - name: "API_INVITATION_THROTTLE_RATE"
      value: {{ . | quote }}
    {{- end }}
    {{- with .documentAskForAccess }}
    - name: "API_DOCUMENT_ASK_FOR_ACCESS_THROTTLE_RATE"
      value: {{ . | quote }}
    {{- end }}
    {{- with .config }}
    - name: "API_CONFIG_THROTTLE_RATE"
      value: {{ . | quote }}
    {{- end }}
    {{- with .userListBurst }}
    - name: "API_USERS_LIST_THROTTLE_RATE_BURST"
      value: {{ . | quote }}
    {{- end }}
    {{- with .userListSustained }}
    - name: "API_USERS_LIST_THROTTLE_RATE_SUSTAINED"
      value: {{ . | quote }}
    {{- end }}
  {{- end }}
  containerSecurityContext:
    allowPrivilegeEscalation: false
    capabilities:
      drop:
        - "ALL"
    enabled: true
    privileged: false
    runAsUser: 1001
    runAsGroup: 1001
    seccompProfile:
      type: "RuntimeDefault"
    readOnlyRootFilesystem: true
    runAsNonRoot: true
    seLinuxOptions:
      {{ .Values.seLinuxOptions.notesBackend | toYaml | nindent 6 }}
  podAnnotations:
    intents.otterize.com/service-name: "impress-backend"
    {{- with .Values.annotations.notesBackend.pod }}
    {{ . | toYaml | nindent 4 }}
    {{- end }}
  podAnnotationsCreateUser:
    intents.otterize.com/service-name: "impress-create-user"
    {{- with .Values.annotations.notesBackend.createUserJob }}
    {{ . | toYaml | nindent 4 }}
    {{- end }}
  podAnnotationsMigrate:
    intents.otterize.com/service-name: "impress-migrate"
    {{- with .Values.annotations.notesBackend.migrateJob }}
    {{ . | toYaml | nindent 4 }}
    {{- end }}
  podSecurityContext:
    enabled: true
    fsGroup: 1000
    fsGroupChangePolicy: "Always"
  resources:
    {{ .Values.resources.notesBackend | toYaml | nindent 4 }}
  service:
    annotations:
      {{ .Values.annotations.notesBackend.service | toYaml | nindent 6 }}
  extraVolumes:
    - name: "customization-volume"
      configMap:
        name: "impress-customization"
  {{- if .Values.trust.secret.mount }}
    - name: "trusted-cert-secret-volume"
      secret:
        secretName: {{ .Values.trust.secret.name | quote }}
        items:
          - key: "ca.crt"
            path: "ca-certificates.crt"
  {{- end }}
  extraVolumeMounts:
    - name: "customization-volume"
      mountPath: "/app/impress/configuration/theme/default.json"
      subPath: "theme.json"
  {{- if .Values.trust.secret.mount }}
    - name: "trusted-cert-secret-volume"
      mountPath: "/cert/cacert.pem"
      subPath: "ca-certificates.crt"
  {{- end }}
  # Runs the backend's background tasks: notifying the collaboration server after a permission
  # change, and sending "ask for access" mails.
  worker:
    enabled: true
    replicaCount: {{ .Values.replicas.notesWorker }}
    resources:
      {{ .Values.resources.notesWorker | toYaml | nindent 6 }}
    podAnnotations:
      intents.otterize.com/service-name: "impress-worker"
      {{- with .Values.annotations.notesWorker.pod }}
      {{ . | toYaml | nindent 6 }}
      {{- end }}

frontend:
  image:
    registry: {{ coalesce .Values.repositories.image.registryOpencodeDe .Values.global.imageRegistry .Values.images.notesFrontend.registry | quote }}
    repository: {{ .Values.images.notesFrontend.repository | quote }}
    pullPolicy: {{ .Values.global.imagePullPolicy | quote }}
    tag: {{ .Values.images.notesFrontend.tag | quote }}
  ingress:
    enabled: true
    annotations:
      {{ .Values.annotations.notesFrontend.ingress | toYaml | nindent 6 }}
    ingressClassName: {{ .Values.ingress.ingressClassName }}
  replicaCount: {{ .Values.replicas.notesFrontend }}
  resources:
    {{ .Values.resources.notesFrontend | toYaml | nindent 4 }}
  containerSecurityContext:
    allowPrivilegeEscalation: false
    capabilities:
      drop:
        - "ALL"
    enabled: true
    privileged: false
    runAsUser: 1000
    runAsGroup: 1000
    seccompProfile:
      type: "RuntimeDefault"
    readOnlyRootFilesystem: true
    runAsNonRoot: true
    seLinuxOptions:
      {{ .Values.seLinuxOptions.notesFrontend | toYaml | nindent 6 }}
  podAnnotations:
    intents.otterize.com/service-name: "impress-frontend"
    {{- with .Values.annotations.notesFrontend.pod }}
    {{ . | toYaml | nindent 4 }}
    {{- end }}
  podSecurityContext:
    enabled: true
    fsGroup: 1000
    fsGroupChangePolicy: "Always"
  service:
    annotations:
      {{ .Values.annotations.notesFrontend.service | toYaml | nindent 6 }}
  extraVolumes:
    - name: "customization-volume"
      configMap:
        name: "impress-customization"
  extraVolumeMounts:
    - name: "customization-volume"
      # Docs v5 builds the static frontend into /app instead of
      # /usr/share/nginx/html; runtime-env.js has to sit in the served root or
      # window.RUNTIME_ENV stays undefined and the central menu gets no URLs.
      mountPath: "/app/runtime-env.js"
      subPath: "runtime-env.js"

docspec:
  enabled: true
  image:
    registry: {{ coalesce .Values.repositories.image.registryOpencodeDe .Values.global.imageRegistry .Values.images.notesDocspec.registry | quote }}
    repository: {{ .Values.images.notesDocspec.repository | quote }}
    pullPolicy: {{ .Values.global.imagePullPolicy | quote }}
    tag: {{ .Values.images.notesDocspec.tag | quote }}
  replicaCount: {{ .Values.replicas.notesDocspec }}
  resources:
    {{ .Values.resources.notesDocspec | toYaml | nindent 4 }}
  containerSecurityContext:
    allowPrivilegeEscalation: false
    capabilities:
      drop:
        - "ALL"
    enabled: true
    privileged: false
    runAsUser: 1000
    runAsGroup: 1000
    seccompProfile:
      type: "RuntimeDefault"
    readOnlyRootFilesystem: true
    runAsNonRoot: true
    seLinuxOptions:
      {{ .Values.seLinuxOptions.notesDocspec | toYaml | nindent 6 }}
  podAnnotations:
    intents.otterize.com/service-name: "impress-docspec"
    {{- with .Values.annotations.notesDocspec.pod }}
    {{ . | toYaml | nindent 4 }}
    {{- end }}
  podSecurityContext:
    enabled: true
    fsGroup: 1000
    fsGroupChangePolicy: "Always"
  service:
    annotations:
      {{ .Values.annotations.notesDocspec.service | toYaml | nindent 6 }}

y-provider:
  image:
    registry: {{ coalesce .Values.repositories.image.registryOpencodeDe .Values.global.imageRegistry .Values.images.notesYProvider.registry | quote }}
    repository: {{ .Values.images.notesYProvider.repository | quote }}
    pullPolicy: {{ .Values.global.imagePullPolicy | quote }}
    tag: {{ .Values.images.notesYProvider.tag }}
  replicaCount: {{ .Values.replicas.notesYProvider }}
  debug: true
  {{- if .Values.trust.secret.mount }}
  extraEnvVars:
    - name: "NODE_EXTRA_CA_CERTS"
      value: "/etc/ssl/certs/cacert.pem"
  extraVolumes:
    - name: "trusted-cert-secret-volume"
      secret:
        secretName: {{ .Values.trust.secret.name | quote }}
        items:
          - key: "ca.crt"
            path: "ca-certificates.crt"
  extraVolumeMounts:
    - name: "trusted-cert-secret-volume"
      mountPath: "/etc/ssl/certs/cacert.pem"
      subPath: "ca-certificates.crt"
  {{- end }}
  containerSecurityContext:
    allowPrivilegeEscalation: false
    capabilities:
      drop:
        - "ALL"
    enabled: true
    privileged: false
    runAsUser: 1001
    runAsGroup: 1001
    seccompProfile:
      type: "RuntimeDefault"
    readOnlyRootFilesystem: true
    runAsNonRoot: true
    seLinuxOptions:
      {{ .Values.seLinuxOptions.notesBackend | toYaml | nindent 6 }}
  ingressCollaborationApi:
    annotations:
      nginx.ingress.kubernetes.io/upstream-hash-by: "$arg_room"
      haproxy-ingress.github.io/balance-algorithm: "url_param room"
      haproxy-ingress.github.io/config-backend: |
        hash-type consistent
    {{- with .Values.annotations.notesYProvider.ingressCollaborationAPI }}
      {{ . | toYaml | nindent 6 }}
    {{- end }}
    ingressClassName: {{ .Values.ingress.ingressClassName }}
  ingressCollaborationWs:
    annotations:
      nginx.ingress.kubernetes.io/proxy-read-timeout: "{{ .Values.ingress.parameters.bodyTimeout.notesYprovider }}"
      nginx.ingress.kubernetes.io/proxy-send-timeout: "{{ .Values.ingress.parameters.bodyTimeout.notesYprovider }}"
      nginx.ingress.kubernetes.io/upstream-hash-by: "$arg_room"
      haproxy-ingress.github.io/timeout-server: "{{ .Values.ingress.parameters.bodyTimeout.notesYprovider }}s"
      haproxy-ingress.github.io/timeout-client: "{{ .Values.ingress.parameters.bodyTimeout.notesYprovider }}s"
      haproxy-ingress.github.io/balance-algorithm: "url_param room"
      haproxy-ingress.github.io/config-backend: |
        hash-type consistent
    {{- with .Values.annotations.notesYProvider.ingressCollaborationWS }}
      {{ . | toYaml | nindent 6 }}
    {{- end }}
    ingressClassName: {{ .Values.ingress.ingressClassName }}
  podAnnotations:
    intents.otterize.com/service-name: "impress-y-provider"
    {{- with .Values.annotations.notesYProvider.pod }}
    {{ . | toYaml | nindent 4 }}
    {{- end }}
  podSecurityContext:
    enabled: true
    fsGroup: 1001
    fsGroupChangePolicy: "Always"
  service:
    annotations:
      {{ .Values.annotations.notesYProvider.service | toYaml | nindent 6 }}
...
