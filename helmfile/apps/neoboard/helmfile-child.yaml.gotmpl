---
repositories:
  # Neoboard Standalone
  # Source: https://github.com/nordeck/matrix-neoboard-standalone
  - name: "matrix-neoboard-standalone-repo"
    keyring: "../../files/gpg-pubkeys/opendesk.gpg"
    verify: {{ .Values.charts.neoboard.verify }}
    username: {{ env "OD_PRIVATE_REGISTRY_USERNAME" | quote }}
    password: {{ env "OD_PRIVATE_REGISTRY_PASSWORD" | quote }}
    oci: true
    url: "{{ coalesce .Values.repositories.helm.registryOpencodeDe .Values.global.helmRegistry | default .Values.charts.neoboard.registry }}/{{ .Values.charts.neoboard.repository }}"

releases:
  - name: "matrix-neoboard-standalone"
    chart: "matrix-neoboard-standalone-repo/{{ .Values.charts.neoboard.name }}"
    version: "{{ .Values.charts.neoboard.version }}"
    values:
      - "values.yaml.gotmpl"
      {{- range .Values.customization.release.neoboard }}
      - {{ . }}
      {{- end }}
    installed: {{ .Values.apps.neoboard.enabled }}
    timeout: {{ .Values.deployment.timeouts.releases.matrixNeoboardStandalone | default .Values.deployment.timeouts.default }}

commonLabels:
  deployStage: "050-components"
  component: "neoboard"
...
