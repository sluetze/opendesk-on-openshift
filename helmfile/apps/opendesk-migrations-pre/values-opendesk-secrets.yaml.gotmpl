---
# Secrets provisioned by the opendesk-secrets chart. Instead of a static list, this iterates the
# openDesk value trees that may carry externalized secrets and picks up every one that is fully
# defined as per convention as a node that provides {value, create, name, key, [extraData]}.
# Entries with `create: true` and a non-null `value` are passed to the chart, including explicit
# empty strings (`""`). Missing or null values are omitted. A `create: false` entry is a reference
# to a user-managed Secret and is omitted.
#
# Trees scanned: the central `secrets` tree (secrets.yaml.gotmpl) plus the domain files that now
# co-locate their own secrets: `objectstores` (objectstores.yaml.gotmpl), `databases`
# (database.yaml.gotmpl) and `cache` (cache.yaml.gotmpl).
#
# Recursively visit maps at any depth. Eligible secret nodes are emitted once; other maps
# are traversed for nested secrets. Scalars and lists are ignored.
{{- define "opendesk.managedSecrets" -}}
  {{- if kindIs "map" . -}}
    {{- if and (hasKey . "name") (hasKey . "create") .create (hasKey . "value") (ne (index . "value") nil) }}
  - name: {{ .name | quote }}
    create: true
    key: {{ .key | quote }}
    value: {{ .value | quote }}
      {{- if hasKey . "extraData" }}
    extraData:
        {{- toYaml (index . "extraData") | nindent 6 }}
      {{- end }}
    {{- else -}}
      {{- range $child := . -}}
        {{- template "opendesk.managedSecrets" $child -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end }}

managedSecrets:
  {{- range $tree := (list .Values.secrets .Values.objectstores .Values.databases .Values.cache) -}}
    {{- template "opendesk.managedSecrets" $tree -}}
  {{- end }}
...
