---
global:
  domain: {{ .Values.global.domain | quote }}
  hosts:
    {{- if .Values.apps.collabora.enabled }}
    collabora: {{ .Values.global.hosts.collabora }}
    {{- end }}
    {{- if .Values.apps.cryptpad.enabled }}
    cryptpad: {{ .Values.global.hosts.cryptpad }}
    {{- end }}
    {{- if or .Values.apps.element.enabled .Values.apps.neoboard.enabled }}
    matrixAuthenticationService: {{ .Values.global.hosts.matrixAuthenticationService }}
    matrixRTC: {{ .Values.global.hosts.matrixRTC }}
    synapse: {{ .Values.global.hosts.synapse }}
    {{- if .Values.apps.element.enabled }}
    elementWeb: {{ .Values.global.hosts.elementWeb }}
    matrixNeoBoardWidget: {{ .Values.global.hosts.matrixNeoBoardWidget }}
    matrixNeoChoiceWidget: {{ .Values.global.hosts.matrixNeoChoiceWidget }}
    matrixNeoDateFixBot: {{ .Values.global.hosts.matrixNeoDateFixBot }}
    matrixNeoDateFixWidget: {{ .Values.global.hosts.matrixNeoDateFixWidget }}
    {{- end }}
    {{- if .Values.apps.elementAdmin.enabled }}
    elementAdmin: {{ .Values.global.hosts.elementAdmin }}
    {{- end }}
    {{- if .Values.apps.elementSupervision.enabled }}
    elementSupervision: {{ .Values.global.hosts.elementSupervision }}
    {{- end }}
    {{- if .Values.apps.neoboard.enabled }}
    whiteboard: {{ .Values.global.hosts.whiteboard }}
    {{- end }}
    {{- end }}
    {{- if .Values.apps.jitsi.enabled }}
    jitsi: {{ .Values.global.hosts.jitsi }}
    {{- end }}
    {{- if .Values.apps.minio.enabled }}
    minioApi: {{ .Values.global.hosts.minioApi }}
    minioConsole: {{ .Values.global.hosts.minioConsole }}
    {{- end }}
    {{- if .Values.apps.seaweedfs.enabled }}
    seaweedfsApi: {{ .Values.global.hosts.seaweedfs }}
    seaweedfsConsole: {{ .Values.global.hosts.seaweedfsAdmin }}
    {{- end }}
    {{- if .Values.apps.nextcloud.enabled }}
    nextcloud: {{ .Values.global.hosts.nextcloud }}
    {{- end }}
    {{- if .Values.apps.notes.enabled }}
    notes: {{ .Values.global.hosts.notes }}
    {{- end }}
    {{- if .Values.apps.nubus.enabled }}
    intercomService: {{ .Values.global.hosts.intercomService }}
    keycloak: {{ .Values.global.hosts.keycloak }}
    nubus: {{ .Values.global.hosts.nubus }}
    {{- end }}
    {{- if .Values.apps.openproject.enabled }}
    openproject: {{ .Values.global.hosts.openproject }}
    {{- end }}
    {{- if .Values.apps.oxAppSuite.enabled }}
    openxchange: {{ .Values.global.hosts.openxchange }}
    openxchangeDav: {{ .Values.global.hosts.openxchangeDav }}
    # In functional.yaml.gotmpl the externalClients.fqdnImap and externalClients.fqdnSmtp can be set.
    # If they are a subdomains of the global.domain, we want to add then to the hosts list of the cert.
    {{- $domainSuffix := printf ".%s" .Values.global.domain }}
    {{- $fqdnImap := .Values.functional.groupware.externalClients.fqdnImap | default "" }}
    {{- $fqdnSmtp := .Values.functional.groupware.externalClients.fqdnSmtp | default "" }}
    {{- if hasSuffix $domainSuffix $fqdnImap }}
    mailImap: {{ trimSuffix $domainSuffix $fqdnImap }}
    {{- end }}
    {{- if hasSuffix $domainSuffix $fqdnSmtp }}
    mailSmtp: {{ trimSuffix $domainSuffix $fqdnSmtp }}
    {{- end }}
    {{- end }}
    {{- if .Values.apps.staticFiles.enabled }}
    static: {{ .Values.global.hosts.static }}
    {{- end }}
    {{- if .Values.apps.xwiki.enabled }}
    xwiki: {{ .Values.global.hosts.xwiki }}
    {{- end }}

issuerRef:
  name: {{ .Values.certificate.issuerRef.name | quote }}
  kind: {{ .Values.certificate.issuerRef.kind | quote }}
  group: {{ .Values.certificate.issuerRef.group | quote }}

cleanup:
  keepRessourceOnDelete: {{ .Values.debug.cleanup.keepRessourceOnDelete }}

selfSigned:
  enabled: {{ .Values.certificate.selfSigned }}
  issuer:
    create: {{ .Values.certificate.selfSignedOverrides.issuer.create }}
  caCertificate:
    create: {{ .Values.certificate.selfSignedOverrides.caCertificate.create }}
    secret:
      value:
        certificate: {{ .Values.certificate.selfSignedOverrides.caCertificate.secret.value.certificate | default "" | quote }}
        key: {{ .Values.certificate.selfSignedOverrides.caCertificate.secret.value.key | default "" | quote }}
        truststore: {{ .Values.certificate.selfSignedOverrides.caCertificate.secret.value.truststore | default "" | quote }}
        keystore: {{ .Values.certificate.selfSignedOverrides.caCertificate.secret.value.keystore | default "" | quote }}
      name: {{ .Values.certificate.selfSignedOverrides.caCertificate.secret.name | default "" | quote }}
  organizations: {{ .Values.certificate.selfSignedOverrides.organizations | toYaml | nindent 4 }}
  organizationalUnits: {{ .Values.certificate.selfSignedOverrides.organizationalUnits | toYaml | nindent 4 }}
  keystores:
    jks:
      enabled: true
      password:
        secret:
          name: {{ .Values.secrets.certificates.password.name | quote }}
          key: {{ .Values.secrets.certificates.password.key | quote }}
  privateKey:
    algorithm: {{ .Values.certificate.selfSignedOverrides.privateKey.algorithm | quote }}
    {{- if .Values.certificate.selfSignedOverrides.privateKey.size }}
    size: {{ .Values.certificate.selfSignedOverrides.privateKey.size | int }}
    {{- end }}

wildcard: {{ .Values.certificate.wildcard }}
...
