---
# External TURN for Jitsi and MatrixRTC. Set either host to configure MatrixRTC's external relay as a fallback
# connection path to the LiveKit SFU. MatrixRTC's built-in TURN servers are not used.
turn:
  transport: "udp"
  # Shared secret configured through secrets.turn.sharedSecret (defaults to TURN_CREDENTIALS).
  server:
    host: ""
    port: "3478"
  tls:
    host: ""
    port: "5349"
...
