---
deployment:
  # Timeout in seconds Helm waits for a release to become ready (`helm upgrade --install --timeout`).
  # Releases set to `~` use `default`. Setting `helmfile apply --timeout` overrides all values below.
  timeouts:
    default: 300
    releases:
      # collabora
      collaboraController: ~
      collaboraOnline: ~
      # cryptpad
      cryptpad: ~
      # element
      # Matrix stack pre-install hooks (MAS / syn2mas) exceeded 300s on ocp22.
      element: 2400
      matrixNeoboardWidget: ~
      matrixNeochoiceWidget: ~
      matrixNeodatefixBot: ~
      matrixNeodatefixBotBootstrap: ~
      matrixNeodatefixWidget: ~
      # Includes waiting for the MatrixRTC SFU LoadBalancer IP.
      opendeskElementCustomization: 1200
      opendeskMatrixUserVerificationService: ~
      opendeskMatrixUserVerificationServiceBootstrap: 600
      # jitsi
      # Includes waiting for the JVB LoadBalancer IP.
      jitsi: 1200
      # neoboard
      matrixNeoboardStandalone: ~
      # nextcloud
      opendeskNextcloud: ~
      opendeskNextcloudManagement: 600
      opendeskNextcloudNotifypush: ~
      # notes
      impress: 600
      impressCustomization: ~
      # nubus
      opendeskKeycloakBootstrap: ~
      intercomService: ~
      opendeskProvisioningSynapse: ~
      ums: ~
      # open-xchange
      dovecot: 600
      openXchange: ~
      opendeskOpenXchangeBootstrap: 600
      oxConnector: ~
      postfixOx: ~
      # opendesk-migrations-pre
      opendeskSecrets: ~
      # opendesk-openproject-bootstrap
      opendeskOpenprojectBootstrap: ~
      # opendesk-services
      opendeskAlerts: ~
      opendeskCertificates: ~
      opendeskDashboards: ~
      opendeskHome: ~
      opendeskOtterize: ~
      opendeskStaticFiles: ~
      opendeskTrust: ~
      # openproject
      openproject: 600
      # services-external
      cassandra: ~
      clamav: ~
      clamavSimple: ~
      mariadb: ~
      memcached: ~
      minio: ~
      opendeskDkimpyMilter: ~
      postfix: ~
      postgresql: ~
      redis: ~
      # Bucket hook waits on master gRPC per identity (ocp22 ~34m for many buckets).
      seaweedfs: 2400
      seaweedfsConfig: ~
      # xwiki
      xwiki: 600
...
